# Normalize all text files to LF line endings on checkout.
* text=auto eol=lf

# Explicit text patterns
*.py        text eol=lf
*.sh        text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.json      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.scss      text eol=lf
*.sql       text eol=lf
*.toml      text eol=lf
*.ini       text eol=lf
*.cfg       text eol=lf
*.conf      text eol=lf
*.env       text eol=lf
*.example   text eol=lf
Dockerfile  text eol=lf
.gitignore  text eol=lf
.dockerignore text eol=lf
.gitattributes text eol=lf

# Binary files (no conversion / no diff)
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.webp      binary
*.ico       binary
*.pdf       binary
*.xlsx      binary
*.xls       binary
*.xlsm      binary
*.xlsb      binary
*.zip       binary
*.gz        binary
*.tar       binary
*.woff      binary
*.woff2     binary
*.ttf       binary
*.eot       binary
